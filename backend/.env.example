# BetterP POS QR - backend
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me
DATABASE_URL=postgres://user:password@host:5432/betterp_pos_qr

REDIS_URL=
CACHE_KEY_PREFIX=betterp-pos
REDIS_IGNORE_EXCEPTIONS=true
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0

FRONTEND_BASE_URL=http://localhost:3000
BACKEND_PUBLIC_BASE_URL=http://localhost:8000
BETTERP_PUBLIC_BASE_URL=http://localhost:3000

# Limites de intentos de acceso
AUTH_RATE_LIMIT_LOGIN_ATTEMPTS=8
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_PASSWORD_RECOVERY_ATTEMPTS=4
AUTH_RATE_LIMIT_PASSWORD_RECOVERY_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_GOOGLE_ATTEMPTS=12
AUTH_RATE_LIMIT_GOOGLE_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_REGISTRATION_ATTEMPTS=5
AUTH_RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_TWO_FACTOR_ATTEMPTS=6
AUTH_RATE_LIMIT_TWO_FACTOR_WINDOW_SECONDS=600
PASSWORD_ARGON2_TIME_COST=2
PASSWORD_ARGON2_MEMORY_COST=19456
PASSWORD_ARGON2_PARALLELISM=1

# Acceso con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cobro de la suscripcion (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com

# Facturacion CFDI (Facturama)
FACTURAMA_SANDBOX_BASE_URL=https://apisandbox.facturama.mx
FACTURAMA_SANDBOX_USERNAME=
FACTURAMA_SANDBOX_PASSWORD=
FACTURAMA_PRODUCTION_BASE_URL=https://api.facturama.mx
FACTURAMA_PRODUCTION_USERNAME=
FACTURAMA_PRODUCTION_PASSWORD=

# Correo transaccional (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=BetterP POS QR
RESEND_REPLY_TO=

# Imagenes de producto en almacenamiento S3/R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

# WhatsApp para enviar tickets (opcional)
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
